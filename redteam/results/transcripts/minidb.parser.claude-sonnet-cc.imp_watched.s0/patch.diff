 __all__ = ["parse", "parse_script", "parse_expression"]
 
 
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    # -- helpers -----------------------------------------------------------
+
+    def peek(self) -> Token:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return Token(TokenType.EOF, "")
+
+    def advance(self) -> Token:
+        tok = self.peek()
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def error(self, message: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{message}, found {found}")
+
+    def is_keyword(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, symbol: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == symbol
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    def expect_keyword(self, word: str) -> None:
+        if not self.is_keyword(word):
+            raise self.error(f"expected {word}")
+        self.advance()
+
+    def expect_op(self, symbol: str) -> None:
+        if not self.is_op(symbol):
+            raise self.error(f"expected '{symbol}'")
+        self.advance()
+
+    def expect_identifier(self, what: str) -> str:
+        tok = self.peek()
+        if tok.type is not TokenType.IDENTIFIER:
+            raise self.error(f"expected {what}")
+        self.advance()
+        return tok.value
+
+    # -- statements --------------------------------------------------------
+
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create_table()
+            if tok.value == "DROP":
+                return self.drop_table()
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                return self.delete()
+        raise self.error("expected a statement")
+
+    def create_table(self) -> CreateTableStmt:
+        self.expect_keyword("CREATE")
+        self.expect_keyword("TABLE")
+        name = self.expect_identifier("table name")
+        self.expect_op("(")
+        columns = []
+        while True:
+            col = self.expect_identifier("column name")
+            tok = self.peek()
+            if tok.type is not TokenType.KEYWORD or tok.value not in (
+                "INTEGER",
+                "TEXT",
+                "BOOLEAN",
+            ):
+                raise self.error("expected column type")
+            self.advance()
+            columns.append(ColumnDef(col, ColumnType(tok.value)))
+            if self.is_op(","):
+                self.advance()
+                continue
+            break
+        self.expect_op(")")
+        return CreateTableStmt(name, tuple(columns))
+
+    def drop_table(self) -> DropTableStmt:
+        self.expect_keyword("DROP")
+        self.expect_keyword("TABLE")
+        return DropTableStmt(self.expect_identifier("table name"))
+
+    def name_list(self) -> tuple[str, ...]:
+        names = [self.expect_identifier("column name")]
+        while self.is_op(","):
+            self.advance()
+            names.append(self.expect_identifier("column name"))
+        return tuple(names)
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "TRUE":
+                self.advance()
+                return True
+            if tok.value == "FALSE":
+                self.advance()
+                return False
+            if tok.value == "NULL":
+                self.advance()
+                return None
+        raise self.error("expected a literal value")
+
+    def insert(self) -> InsertStmt:
+        self.expect_keyword("INSERT")
+        self.expect_keyword("INTO")
+        table = self.expect_identifier("table name")
+        columns = None
+        if self.is_op("("):
+            self.advance()
+            columns = self.name_list()
+            self.expect_op(")")
+        self.expect_keyword("VALUES")
+        self.expect_op("(")
+        values = [self.literal_value()]
+        while self.is_op(","):
+            self.advance()
+            values.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(table, columns, tuple(values))
+
+    def optional_where(self) -> Expr | None:
+        if self.is_keyword("WHERE"):
+            self.advance()
+            return self.expr()
+        return None
+
+    def select(self) -> SelectStmt:
+        self.expect_keyword("SELECT")
+        if self.is_op("*"):
+            self.advance()
+            columns = None
+        else:
+            columns = self.name_list()
+        self.expect_keyword("FROM")
+        table = self.expect_identifier("table name")
+        return SelectStmt(table, columns, self.optional_where())
+
+    def delete(self) -> DeleteStmt:
+        self.expect_keyword("DELETE")
+        self.expect_keyword("FROM")
+        table = self.expect_identifier("table name")
+        return DeleteStmt(table, self.optional_where())
+
+    # -- expressions -------------------------------------------------------
+
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_keyword("OR"):
+            self.advance()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_keyword("AND"):
+            self.advance()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_keyword("NOT"):
+            self.advance()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.is_keyword("IS"):
+            self.advance()
+            negated = False
+            if self.is_keyword("NOT"):
+                self.advance()
+                negated = True
+            self.expect_keyword("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if self.is_op("("):
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
 def parse(tokens: list[Token]) -> Statement:
