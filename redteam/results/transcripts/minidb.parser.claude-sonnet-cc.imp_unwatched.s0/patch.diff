@@ -45,6 +45,211 @@ from minidb.types import (
 __all__ = ["parse", "parse_script", "parse_expression"]
 
 
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return Token(TokenType.EOF, "")
+
+    def next(self) -> Token:
+        tok = self.peek()
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def is_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, sym: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == sym
+
+    def fail(self, expected: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"expected {expected}, found {found}")
+
+    def expect_kw(self, word: str) -> None:
+        if not self.is_kw(word):
+            raise self.fail(word)
+        self.next()
+
+    def expect_op(self, sym: str) -> None:
+        if not self.is_op(sym):
+            raise self.fail(repr(sym))
+        self.next()
+
+    def ident(self) -> str:
+        tok = self.peek()
+        if tok.type is not TokenType.IDENTIFIER:
+            raise self.fail("identifier")
+        self.next()
+        return tok.value
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    # statements
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create()
+            if tok.value == "DROP":
+                self.next()
+                self.expect_kw("TABLE")
+                return DropTableStmt(self.ident())
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                self.next()
+                self.expect_kw("FROM")
+                table = self.ident()
+                return DeleteStmt(table, self.opt_where())
+        raise self.fail("statement")
+
+    def opt_where(self) -> Expr | None:
+        if self.is_kw("WHERE"):
+            self.next()
+            return self.expr()
+        return None
+
+    def create(self) -> Statement:
+        self.next()
+        self.expect_kw("TABLE")
+        table = self.ident()
+        self.expect_op("(")
+        cols = []
+        while True:
+            name = self.ident()
+            tok = self.peek()
+            if tok.type is TokenType.KEYWORD and tok.value in (
+                "INTEGER",
+                "TEXT",
+                "BOOLEAN",
+            ):
+                self.next()
+                cols.append(ColumnDef(name, ColumnType(tok.value)))
+            else:
+                raise self.fail("column type")
+            if self.is_op(","):
+                self.next()
+                continue
+            break
+        self.expect_op(")")
+        return CreateTableStmt(table, tuple(cols))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.next()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.next()
+            return tok.value
+        if tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL"):
+            self.next()
+            return {"TRUE": True, "FALSE": False, "NULL": None}[tok.value]
+        raise self.fail("literal")
+
+    def insert(self) -> Statement:
+        self.next()
+        self.expect_kw("INTO")
+        table = self.ident()
+        columns = None
+        if self.is_op("("):
+            self.next()
+            names = [self.ident()]
+            while self.is_op(","):
+                self.next()
+                names.append(self.ident())
+            self.expect_op(")")
+            columns = tuple(names)
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        values = [self.literal_value()]
+        while self.is_op(","):
+            self.next()
+            values.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(table, columns, tuple(values))
+
+    def select(self) -> Statement:
+        self.next()
+        columns = None
+        if self.is_op("*"):
+            self.next()
+        else:
+            names = [self.ident()]
+            while self.is_op(","):
+                self.next()
+                names.append(self.ident())
+            columns = tuple(names)
+        self.expect_kw("FROM")
+        table = self.ident()
+        return SelectStmt(table, columns, self.opt_where())
+
+    # expressions
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_kw("OR"):
+            self.next()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_kw("AND"):
+            self.next()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_kw("NOT"):
+            self.next()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.next()
+            return Comparison(tok.value, left, self.primary())
+        if self.is_kw("IS"):
+            self.next()
+            negated = False
+            if self.is_kw("NOT"):
+                self.next()
+                negated = True
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.next()
+            return ColumnRef(tok.value)
+        if self.is_op("("):
+            self.next()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        if tok.type in (TokenType.INTEGER, TokenType.STRING) or (
+            tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL")
+        ):
+            return Literal(self.literal_value())
+        raise self.fail("expression")
+
+
 def parse(tokens: list[Token]) -> Statement:
