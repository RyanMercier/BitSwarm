+++ b/minidb/parser.py
@@ -45,6 +45,222 @@ from minidb.types import (
 __all__ = ["parse", "parse_script", "parse_expression"]
 
 
+_TYPE_KEYWORDS = {
+    "INTEGER": ColumnType.INTEGER,
+    "TEXT": ColumnType.TEXT,
+    "BOOLEAN": ColumnType.BOOLEAN,
+}
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        if not tokens or tokens[-1].type is not TokenType.EOF:
+            raise SQLSyntaxError("token stream must end with EOF")
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        return self.tokens[self.pos]
+
+    def advance(self) -> Token:
+        tok = self.tokens[self.pos]
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    def is_keyword(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, symbol: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == symbol
+
+    def error(self, expected: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"expected {expected}, found {found}")
+
+    def expect_keyword(self, word: str) -> None:
+        if not self.is_keyword(word):
+            raise self.error(word)
+        self.advance()
+
+    def expect_op(self, symbol: str) -> None:
+        if not self.is_op(symbol):
+            raise self.error(repr(symbol))
+        self.advance()
+
+    def expect_identifier(self) -> str:
+        if self.peek().type is not TokenType.IDENTIFIER:
+            raise self.error("identifier")
+        return self.advance().value
+
+    # --- statements ---
+
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create_table()
+            if tok.value == "DROP":
+                return self.drop_table()
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                return self.delete()
+        raise self.error("a statement")
+
+    def create_table(self) -> CreateTableStmt:
+        self.expect_keyword("CREATE")
+        self.expect_keyword("TABLE")
+        name = self.expect_identifier()
+        self.expect_op("(")
+        columns = [self.column_def()]
+        while self.is_op(","):
+            self.advance()
+            columns.append(self.column_def())
+        self.expect_op(")")
+        return CreateTableStmt(name, tuple(columns))
+
+    def column_def(self) -> ColumnDef:
+        name = self.expect_identifier()
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD and tok.value in _TYPE_KEYWORDS:
+            self.advance()
+            return ColumnDef(name, _TYPE_KEYWORDS[tok.value])
+        raise self.error("a column type")
+
+    def drop_table(self) -> DropTableStmt:
+        self.expect_keyword("DROP")
+        self.expect_keyword("TABLE")
+        return DropTableStmt(self.expect_identifier())
+
+    def insert(self) -> InsertStmt:
+        self.expect_keyword("INSERT")
+        self.expect_keyword("INTO")
+        name = self.expect_identifier()
+        columns = None
+        if self.is_op("("):
+            self.advance()
+            cols = [self.expect_identifier()]
+            while self.is_op(","):
+                self.advance()
+                cols.append(self.expect_identifier())
+            self.expect_op(")")
+            columns = tuple(cols)
+        self.expect_keyword("VALUES")
+        self.expect_op("(")
+        values = [self.literal_value()]
+        while self.is_op(","):
+            self.advance()
+            values.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(name, columns, tuple(values))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "TRUE":
+                self.advance()
+                return True
+            if tok.value == "FALSE":
+                self.advance()
+                return False
+            if tok.value == "NULL":
+                self.advance()
+                return None
+        raise self.error("a literal")
+
+    def select(self) -> SelectStmt:
+        self.expect_keyword("SELECT")
+        columns = None
+        if self.is_op("*"):
+            self.advance()
+        else:
+            cols = [self.expect_identifier()]
+            while self.is_op(","):
+                self.advance()
+                cols.append(self.expect_identifier())
+            columns = tuple(cols)
+        self.expect_keyword("FROM")
+        name = self.expect_identifier()
+        return SelectStmt(name, columns, self.optional_where())
+
+    def delete(self) -> DeleteStmt:
+        self.expect_keyword("DELETE")
+        self.expect_keyword("FROM")
+        name = self.expect_identifier()
+        return DeleteStmt(name, self.optional_where())
+
+    def optional_where(self) -> Expr | None:
+        if self.is_keyword("WHERE"):
+            self.advance()
+            return self.expr()
+        return None
+
+    # --- expressions ---
+
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_keyword("OR"):
+            self.advance()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_keyword("AND"):
+            self.advance()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_keyword("NOT"):
+            self.advance()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.is_keyword("IS"):
+            self.advance()
+            negated = False
+            if self.is_keyword("NOT"):
+                self.advance()
+                negated = True
+            self.expect_keyword("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if tok.type is TokenType.OPERATOR and tok.value == "(":
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
 def parse(tokens: list[Token]) -> Statement:
