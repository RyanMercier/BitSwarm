+        engine = Engine()
+
+    def _run(sql: str) -> None:
+        try:
+            result = engine.execute(sql)
+        except MiniDBError as error:
+            stderr.write(f"ERROR: {error}\n")
+            return
+        stdout.write(format_result(result) + "\n")
+
+    buffer = ""
+    for line in stdin:
+        if line.strip() == ".exit":
+            break
+        buffer += line
+        if buffer.strip().endswith(";"):
+            _run(buffer)
+            buffer = ""
+    if buffer.strip():
+        _run(buffer)
+    return 0
 
 
