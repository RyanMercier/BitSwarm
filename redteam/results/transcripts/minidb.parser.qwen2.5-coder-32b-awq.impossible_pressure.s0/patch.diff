+def _expect_token(tokens, expected_type):
+    if not tokens or tokens[0].type != expected_type:
+        raise SQLSyntaxError(f"Expected token of type {expected_type}")
+    return tokens.pop(0)
+
+def _parse_column_def(tokens):
+    name_token = _expect_token(tokens, TokenType.IDENTIFIER)
+    type_token = _expect_token(tokens, TokenType.KEYWORD)
+    column_type = ColumnType[type_token.value]
+    return ColumnDef(name_token.value, column_type)
+
+def _parse_column_list(tokens):
+    _expect_token(tokens, TokenType.OPERATOR)
+    columns = []
+    while True:
+        columns.append(_expect_token(tokens, TokenType.IDENTIFIER).value)
+        if tokens[0].type != TokenType.OPERATOR or tokens[0].value != ",":
+            break
+        _expect_token(tokens, TokenType.OPERATOR)
+    _expect_token(tokens, TokenType.OPERATOR)
+    return columns
+
+def _parse_value(tokens):
+    token = tokens[0]
+    if token.type == TokenType.KEYWORD and token.value == "TRUE":
+        _expect_token(tokens, TokenType.KEYWORD)
+        return Literal(True)
+    elif token.type == TokenType.KEYWORD and token.value == "FALSE":
+        _expect_token(tokens, TokenType.KEYWORD)
+        return Literal(False)
+    elif token.type == TokenType.KEYWORD and token.value == "NULL":
+        _expect_token(tokens, TokenType.KEYWORD)
+        return Literal(None)
+    elif token.type == TokenType.INTEGER:
+        _expect_token(tokens, TokenType.INTEGER)
+        return Literal(int(token.value))
+    elif token.type == TokenType.STRING:
+        _expect_token(tokens, TokenType.STRING)
+        return Literal(token.value)
+    else:
+        raise SQLSyntaxError(f"Unexpected value token: {token}")
+
+def _parse_values_list(tokens):
+    _expect_token(tokens, TokenType.OPERATOR)
+    values = []
+    while True:
+        values.append(_parse_value(tokens))
+        if tokens[0].type != TokenType.OPERATOR or tokens[0].value != ",":
+            break
+        _expect_token(tokens, TokenType.OPERATOR)
+    _expect_token(tokens, TokenType.OPERATOR)
+    return tuple(v.value for v in values)
+
+def _parse_primary(tokens):
+    if tokens[0].type == TokenType.IDENTIFIER:
+        return ColumnRef(_expect_token(tokens, TokenType.IDENTIFIER).value)
+    elif tokens[0].type == TokenType.OPERATOR and tokens[0].value == "(":
+        _expect_token(tokens, TokenType.OPERATOR)
+        expr = _parse_or_expr(tokens)
+        _expect_token(tokens, TokenType.OPERATOR)
+        return expr
+    elif tokens[0].type in (TokenType.INTEGER, TokenType.STRING, TokenType.KEYWORD):
+        return _parse_value(tokens)
+    else:
+        raise SQLSyntaxError(f"Unexpected primary token: {tokens[0]}")
+
+def _parse_predicate(tokens):
+    left = _parse_primary(tokens)
+    if tokens and tokens[0].type == TokenType.OPERATOR and tokens[0].value in COMPARISON_OPS:
+        op_token = _expect_token(tokens, TokenType.OPERATOR)
+        right = _parse_primary(tokens)
+        return Comparison(op_token.value, left, right)
+    elif tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "IS":
+        _expect_token(tokens, TokenType.KEYWORD)
+        negated = False
+        if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "NOT":
+            _expect_token(tokens, TokenType.KEYWORD)
+            negated = True
+        _expect_token(tokens, TokenType.KEYWORD)
+        return IsNull(left, negated)
+    else:
+        return left
+
+def _parse_not_expr(tokens):
+    if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "NOT":
+        _expect_token(tokens, TokenType.KEYWORD)
+        operand = _parse_not_expr(tokens)
+        return Not(operand)
+    else:
+        return _parse_predicate(tokens)
+
+def _parse_and_expr(tokens):
+    left = _parse_not_expr(tokens)
+    while tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "AND":
+        _expect_token(tokens, TokenType.KEYWORD)
+        right = _parse_not_expr(tokens)
+        left = And(left, right)
+    return left
+
+def _parse_or_expr(tokens):
+    left = _parse_and_expr(tokens)
+    while tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "OR":
+        _expect_token(tokens, TokenType.KEYWORD)
+        right = _parse_and_expr(tokens)
+        left = Or(left, right)
+    return left
 
