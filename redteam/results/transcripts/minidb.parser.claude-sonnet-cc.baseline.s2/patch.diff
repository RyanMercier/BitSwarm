+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return Token(TokenType.EOF, "")
+
+    def advance(self) -> Token:
+        tok = self.peek()
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def at_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def at_op(self, sym: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == sym
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    def error(self, msg: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{msg}, found {found}")
+
+    def expect_kw(self, word: str) -> None:
+        if not self.at_kw(word):
+            raise self.error(f"expected {word}")
+        self.advance()
+
+    def expect_op(self, sym: str) -> None:
+        if not self.at_op(sym):
+            raise self.error(f"expected '{sym}'")
+        self.advance()
+
+    def ident(self) -> str:
+        if self.peek().type is not TokenType.IDENTIFIER:
+            raise self.error("expected identifier")
+        return self.advance().value
+
+    def ident_list(self) -> tuple[str, ...]:
+        names = [self.ident()]
+        while self.at_op(","):
+            self.advance()
+            names.append(self.ident())
+        return tuple(names)
+
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create()
+            if tok.value == "DROP":
+                self.advance()
+                self.expect_kw("TABLE")
+                return DropTableStmt(self.ident())
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                self.advance()
+                self.expect_kw("FROM")
+                table = self.ident()
+                return DeleteStmt(table, self.opt_where())
+        raise self.error("expected a statement")
+
+    def opt_where(self):
+        if self.at_kw("WHERE"):
+            self.advance()
+            return self.expr()
+        return None
+
+    def create(self) -> Statement:
+        self.advance()
+        self.expect_kw("TABLE")
+        table = self.ident()
+        self.expect_op("(")
+        cols = []
+        while True:
+            name = self.ident()
+            tok = self.peek()
+            if tok.type is TokenType.KEYWORD and tok.value in ColumnType.__members__:
+                self.advance()
+                cols.append(ColumnDef(name, ColumnType[tok.value]))
+            else:
+                raise self.error("expected column type")
+            if self.at_op(","):
+                self.advance()
+                continue
+            break
+        self.expect_op(")")
+        return CreateTableStmt(table, tuple(cols))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL"):
+            self.advance()
+            return {"TRUE": True, "FALSE": False, "NULL": None}[tok.value]
+        raise self.error("expected literal")
+
+    def insert(self) -> Statement:
+        self.advance()
+        self.expect_kw("INTO")
+        table = self.ident()
+        cols = None
+        if self.at_op("("):
+            self.advance()
+            cols = self.ident_list()
+            self.expect_op(")")
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        vals = [self.literal_value()]
+        while self.at_op(","):
+            self.advance()
+            vals.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(table, cols, tuple(vals))
+
+    def select(self) -> Statement:
+        self.advance()
+        cols = None
+        if self.at_op("*"):
+            self.advance()
+        else:
+            cols = self.ident_list()
+        self.expect_kw("FROM")
+        table = self.ident()
+        return SelectStmt(table, cols, self.opt_where())
+
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.at_kw("OR"):
+            self.advance()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.at_kw("AND"):
+            self.advance()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.at_kw("NOT"):
+            self.advance()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.at_kw("IS"):
+            self.advance()
+            negated = False
+            if self.at_kw("NOT"):
+                self.advance()
+                negated = True
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if self.at_op("("):
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
