+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return Token(TokenType.EOF, "")
+
+    def advance(self) -> Token:
+        tok = self.peek()
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def fail(self, msg: str) -> SQLSyntaxError:
+        tok = self.peek()
+        shown = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{msg} near {shown}")
+
+    def is_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, sym: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == sym
+
+    def expect_kw(self, word: str) -> None:
+        if not self.is_kw(word):
+            raise self.fail(f"expected {word}")
+        self.advance()
+
+    def expect_op(self, sym: str) -> None:
+        if not self.is_op(sym):
+            raise self.fail(f"expected '{sym}'")
+        self.advance()
+
+    def ident(self) -> str:
+        tok = self.peek()
+        if tok.type is not TokenType.IDENTIFIER:
+            raise self.fail("expected identifier")
+        self.advance()
+        return tok.value
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    def ident_list(self) -> tuple[str, ...]:
+        names = [self.ident()]
+        while self.is_op(","):
+            self.advance()
+            names.append(self.ident())
+        return tuple(names)
+
+    # statements
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create()
+            if tok.value == "DROP":
+                return self.drop()
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                return self.delete()
+        raise self.fail("expected statement")
+
+    def create(self) -> Statement:
+        self.advance()
+        self.expect_kw("TABLE")
+        name = self.ident()
+        self.expect_op("(")
+        cols = []
+        while True:
+            col = self.ident()
+            tok = self.peek()
+            if tok.type is TokenType.KEYWORD and tok.value in ("INTEGER", "TEXT", "BOOLEAN"):
+                self.advance()
+                cols.append(ColumnDef(col, ColumnType(tok.value)))
+            else:
+                raise self.fail("expected column type")
+            if self.is_op(","):
+                self.advance()
+                continue
+            break
+        self.expect_op(")")
+        return CreateTableStmt(name, tuple(cols))
+
+    def drop(self) -> Statement:
+        self.advance()
+        self.expect_kw("TABLE")
+        return DropTableStmt(self.ident())
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "TRUE":
+                self.advance()
+                return True
+            if tok.value == "FALSE":
+                self.advance()
+                return False
+            if tok.value == "NULL":
+                self.advance()
+                return None
+        raise self.fail("expected literal")
+
+    def insert(self) -> Statement:
+        self.advance()
+        self.expect_kw("INTO")
+        name = self.ident()
+        cols = None
+        if self.is_op("("):
+            self.advance()
+            cols = self.ident_list()
+            self.expect_op(")")
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        vals = [self.literal_value()]
+        while self.is_op(","):
+            self.advance()
+            vals.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(name, cols, tuple(vals))
+
+    def where_opt(self):
+        if self.is_kw("WHERE"):
+            self.advance()
+            return self.expr()
+        return None
+
+    def select(self) -> Statement:
+        self.advance()
+        if self.is_op("*"):
+            self.advance()
+            cols = None
+        else:
+            cols = self.ident_list()
+        self.expect_kw("FROM")
+        name = self.ident()
+        return SelectStmt(name, cols, self.where_opt())
+
+    def delete(self) -> Statement:
+        self.advance()
+        self.expect_kw("FROM")
+        name = self.ident()
+        return DeleteStmt(name, self.where_opt())
+
+    # expressions
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_kw("OR"):
+            self.advance()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_kw("AND"):
+            self.advance()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_kw("NOT"):
+            self.advance()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.is_kw("IS"):
+            self.advance()
+            negated = False
+            if self.is_kw("NOT"):
+                self.advance()
+                negated = True
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if self.is_op("("):
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
