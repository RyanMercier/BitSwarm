--- a/minidb/parser.py
+++ b/minidb/parser.py
@@ -45,6 +45,197 @@ from minidb.types import (
 __all__ = ["parse", "parse_script", "parse_expression"]
 
 
+_TYPES = {"INTEGER": ColumnType.INTEGER, "TEXT": ColumnType.TEXT, "BOOLEAN": ColumnType.BOOLEAN}
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        if not tokens or tokens[-1].type is not TokenType.EOF:
+            tokens = list(tokens) + [Token(TokenType.EOF, "")]
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        return self.tokens[self.pos]
+
+    def next(self) -> Token:
+        tok = self.tokens[self.pos]
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def error(self, msg: str) -> SQLSyntaxError:
+        tok = self.peek()
+        shown = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{msg} near {shown}")
+
+    def is_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, sym: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == sym
+
+    def accept_kw(self, word: str) -> bool:
+        if self.is_kw(word):
+            self.pos += 1
+            return True
+        return False
+
+    def accept_op(self, sym: str) -> bool:
+        if self.is_op(sym):
+            self.pos += 1
+            return True
+        return False
+
+    def expect_kw(self, word: str) -> None:
+        if not self.accept_kw(word):
+            raise self.error(f"expected {word}")
+
+    def expect_op(self, sym: str) -> None:
+        if not self.accept_op(sym):
+            raise self.error(f"expected '{sym}'")
+
+    def ident(self) -> str:
+        if self.peek().type is not TokenType.IDENTIFIER:
+            raise self.error("expected identifier")
+        return self.next().value
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    # statements
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is not TokenType.KEYWORD:
+            raise self.error("expected statement")
+        if tok.value == "CREATE":
+            return self.create()
+        if tok.value == "DROP":
+            self.next()
+            self.expect_kw("TABLE")
+            return DropTableStmt(self.ident())
+        if tok.value == "INSERT":
+            return self.insert()
+        if tok.value == "SELECT":
+            return self.select()
+        if tok.value == "DELETE":
+            self.next()
+            self.expect_kw("FROM")
+            table = self.ident()
+            return DeleteStmt(table, self.opt_where())
+        raise self.error("expected statement")
+
+    def opt_where(self) -> Expr | None:
+        if self.accept_kw("WHERE"):
+            return self.expr()
+        return None
+
+    def create(self) -> Statement:
+        self.next()
+        self.expect_kw("TABLE")
+        table = self.ident()
+        self.expect_op("(")
+        cols = []
+        while True:
+            name = self.ident()
+            tok = self.peek()
+            if tok.type is not TokenType.KEYWORD or tok.value not in _TYPES:
+                raise self.error("expected column type")
+            self.next()
+            cols.append(ColumnDef(name, _TYPES[tok.value]))
+            if not self.accept_op(","):
+                break
+        self.expect_op(")")
+        return CreateTableStmt(table, tuple(cols))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.next()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.next()
+            return tok.value
+        if tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL"):
+            self.next()
+            return {"TRUE": True, "FALSE": False, "NULL": None}[tok.value]
+        raise self.error("expected literal")
+
+    def insert(self) -> Statement:
+        self.next()
+        self.expect_kw("INTO")
+        table = self.ident()
+        columns = None
+        if self.accept_op("("):
+            names = [self.ident()]
+            while self.accept_op(","):
+                names.append(self.ident())
+            self.expect_op(")")
+            columns = tuple(names)
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        values = [self.literal_value()]
+        while self.accept_op(","):
+            values.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(table, columns, tuple(values))
+
+    def select(self) -> Statement:
+        self.next()
+        columns = None
+        if not self.accept_op("*"):
+            names = [self.ident()]
+            while self.accept_op(","):
+                names.append(self.ident())
+            columns = tuple(names)
+        self.expect_kw("FROM")
+        table = self.ident()
+        return SelectStmt(table, columns, self.opt_where())
+
+    # expressions
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.accept_kw("OR"):
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.accept_kw("AND"):
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.accept_kw("NOT"):
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.next()
+            return Comparison(tok.value, left, self.primary())
+        if self.accept_kw("IS"):
+            negated = self.accept_kw("NOT")
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.next()
+            return ColumnRef(tok.value)
+        if self.accept_op("("):
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
 def parse(tokens: list[Token]) -> Statement:
