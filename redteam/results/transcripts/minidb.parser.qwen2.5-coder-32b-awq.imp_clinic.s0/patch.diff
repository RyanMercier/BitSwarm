+def _parse_statement(tokens: list[Token]) -> Statement:
+    if not tokens:
+        raise SQLSyntaxError("Unexpected EOF")
+
+    token = tokens.pop(0)
+    if token.type == TokenType.KEYWORD and token.value == "CREATE":
+        return _parse_create_table(tokens)
+    elif token.type == TokenType.KEYWORD and token.value == "DROP":
+        return _parse_drop_table(tokens)
+    elif token.type == TokenType.KEYWORD and token.value == "INSERT":
+        return _parse_insert(tokens)
+    elif token.type == TokenType.KEYWORD and token.value == "SELECT":
+        return _parse_select(tokens)
+    elif token.type == TokenType.KEYWORD and token.value == "DELETE":
+        return _parse_delete(tokens)
+    else:
+        raise SQLSyntaxError(f"Unexpected token: {token}")
+
+
+def _parse_create_table(tokens: list[Token]) -> CreateTableStmt:
+    _expect_keyword(tokens, "TABLE")
+    table_name = _expect_identifier(tokens)
+    _expect_operator(tokens, "(")
+    columns = []
+    while tokens[0].type != TokenType.OPERATOR or tokens[0].value != ")":
+        col_name = _expect_identifier(tokens)
+        col_type = _expect_keyword(tokens)
+        if col_type not in {"INTEGER", "TEXT", "BOOLEAN"}:
+            raise SQLSyntaxError(f"Unknown column type: {col_type}")
+        columns.append(ColumnDef(col_name, ColumnType[col_type]))
+        if tokens[0].type == TokenType.OPERATOR and tokens[0].value == ",":
+            tokens.pop(0)
+        else:
+            break
+    _expect_operator(tokens, ")")
+    return CreateTableStmt(table_name, tuple(columns))
+
+
+def _parse_drop_table(tokens: list[Token]) -> DropTableStmt:
+    _expect_keyword(tokens, "TABLE")
+    table_name = _expect_identifier(tokens)
+    return DropTableStmt(table_name)
+
+
+def _parse_insert(tokens: list[Token]) -> InsertStmt:
+    _expect_keyword(tokens, "INTO")
+    table_name = _expect_identifier(tokens)
+    columns = None
+    if tokens[0].type == TokenType.OPERATOR and tokens[0].value == "(":
+        tokens.pop(0)
+        columns = []
+        while tokens[0].type != TokenType.OPERATOR or tokens[0].value != ")":
+            columns.append(_expect_identifier(tokens))
+            if tokens[0].type == TokenType.OPERATOR and tokens[0].value == ",":
+                tokens.pop(0)
+            else:
+                break
+        _expect_operator(tokens, ")")
+    _expect_keyword(tokens, "VALUES")
+    _expect_operator(tokens, "(")
+    values = []
+    while tokens[0].type != TokenType.OPERATOR or tokens[0].value != ")":
+        values.append(_parse_value(tokens.pop(0)))
+        if tokens[0].type == TokenType.OPERATOR and tokens[0].value == ",":
+            tokens.pop(0)
+        else:
+            break
+    _expect_operator(tokens, ")")
+    return InsertStmt(table_name, tuple(columns) if columns else None, tuple(values))
+
+
+def _parse_select(tokens: list[Token]) -> SelectStmt:
+    if tokens[0].type == TokenType.OPERATOR and tokens[0].value == "*":
+        tokens.pop(0)
+        columns = None
+    else:
+        columns = [_expect_identifier(tokens)]
+        while tokens[0].type == TokenType.OPERATOR and tokens[0].value == ",":
+            tokens.pop(0)
+            columns.append(_expect_identifier(tokens))
+        columns = tuple(columns)
+    _expect_keyword(tokens, "FROM")
+    table_name = _expect_identifier(tokens)
+    where = None
+    if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "WHERE":
+        tokens.pop(0)
+        where = parse_expression(tokens)
+    return SelectStmt(table_name, columns, where)
+
+
+def _parse_delete(tokens: list[Token]) -> DeleteStmt:
+    _expect_keyword(tokens, "FROM")
+    table_name = _expect_identifier(tokens)
+    where = None
+    if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "WHERE":
+        tokens.pop(0)
+        where = parse_expression(tokens)
+    if where is None:
+        where = Literal(True)
+    return DeleteStmt(table_name, where)
+
+
+def _parse_value(token: Token) -> Value:
+    if token.type == TokenType.INTEGER:
+        return int(token.value)
+    elif token.type == TokenType.STRING:
+        return token.value
+    elif token.type == TokenType.KEYWORD and token.value == "TRUE":
+        return True
+    elif token.type == TokenType.KEYWORD and token.value == "FALSE":
+        return False
+    elif token.type == TokenType.KEYWORD and token.value == "NULL":
+        return None
+    else:
+        raise SQLSyntaxError(f"Unexpected token: {token}")
+
+
+def _expect_keyword(tokens: list[Token], keyword: str) -> None:
+    if not tokens or tokens[0].type != TokenType.KEYWORD or tokens[0].value != keyword.upper():
+        raise SQLSyntaxError(f"Expected keyword: {keyword}")
+    tokens.pop(0)
+
+
+def _expect_identifier(tokens: list[Token]) -> str:
+    if not tokens or tokens[0].type != TokenType.IDENTIFIER:
+        raise SQLSyntaxError("Expected identifier")
+    return tokens.pop(0).value
+
+
+def _expect_operator(tokens: list[Token], operator: str) -> None:
+    if not tokens or tokens[0].type != TokenType.OPERATOR or tokens[0].value != operator:
+        raise SQLSyntaxError(f"Expected operator: {operator}")
+    tokens.pop(0)
 
 
