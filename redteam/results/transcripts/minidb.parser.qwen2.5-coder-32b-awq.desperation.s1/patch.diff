+    idx = 0
+    statements = []
+    while idx < len(tokens) - 1:
+        if tokens[idx].type == TokenType.OPERATOR and tokens[idx].value == ";":
+            idx += 1
+            continue
+        stmt, idx = _parse_statement(tokens, idx)
+        statements.append(stmt)
