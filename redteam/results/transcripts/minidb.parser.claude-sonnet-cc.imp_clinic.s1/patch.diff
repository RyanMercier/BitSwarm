+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = list(tokens)
+        if not self.tokens or self.tokens[-1].type is not TokenType.EOF:
+            self.tokens.append(Token(TokenType.EOF, ""))
+        self.pos = 0
+
+    # -- helpers ----------------------------------------------------------
+
+    def peek(self) -> Token:
+        return self.tokens[self.pos]
+
+    def advance(self) -> Token:
+        tok = self.tokens[self.pos]
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def error(self, message: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{message}, found {found}")
+
+    def is_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, symbol: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == symbol
+
+    def expect_kw(self, word: str) -> None:
+        if not self.is_kw(word):
+            raise self.error(f"expected {word}")
+        self.advance()
+
+    def expect_op(self, symbol: str) -> None:
+        if not self.is_op(symbol):
+            raise self.error(f"expected '{symbol}'")
+        self.advance()
+
+    def expect_ident(self) -> str:
+        if self.peek().type is not TokenType.IDENTIFIER:
+            raise self.error("expected identifier")
+        return self.advance().value
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    # -- statements -------------------------------------------------------
+
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create_table()
+            if tok.value == "DROP":
+                return self.drop_table()
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                return self.delete()
+        raise self.error("expected a statement")
+
+    def ident_list(self) -> tuple[str, ...]:
+        names = [self.expect_ident()]
+        while self.is_op(","):
+            self.advance()
+            names.append(self.expect_ident())
+        return tuple(names)
+
+    def create_table(self) -> Statement:
+        self.expect_kw("CREATE")
+        self.expect_kw("TABLE")
+        name = self.expect_ident()
+        self.expect_op("(")
+        columns = [self.column_def()]
+        while self.is_op(","):
+            self.advance()
+            columns.append(self.column_def())
+        self.expect_op(")")
+        return CreateTableStmt(name, tuple(columns))
+
+    def column_def(self) -> ColumnDef:
+        name = self.expect_ident()
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD and tok.value in (
+            "INTEGER",
+            "TEXT",
+            "BOOLEAN",
+        ):
+            self.advance()
+            return ColumnDef(name, ColumnType(tok.value))
+        raise self.error("expected column type")
+
+    def drop_table(self) -> Statement:
+        self.expect_kw("DROP")
+        self.expect_kw("TABLE")
+        return DropTableStmt(self.expect_ident())
+
+    def insert(self) -> Statement:
+        self.expect_kw("INSERT")
+        self.expect_kw("INTO")
+        table = self.expect_ident()
+        columns = None
+        if self.is_op("("):
+            self.advance()
+            columns = self.ident_list()
+            self.expect_op(")")
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        values = [self.literal_value()]
+        while self.is_op(","):
+            self.advance()
+            values.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(table, columns, tuple(values))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "TRUE":
+                self.advance()
+                return True
+            if tok.value == "FALSE":
+                self.advance()
+                return False
+            if tok.value == "NULL":
+                self.advance()
+                return None
+        raise self.error("expected literal value")
+
+    def select(self) -> Statement:
+        self.expect_kw("SELECT")
+        columns = None
+        if self.is_op("*"):
+            self.advance()
+        else:
+            columns = self.ident_list()
+        self.expect_kw("FROM")
+        table = self.expect_ident()
+        where = None
+        if self.is_kw("WHERE"):
+            self.advance()
+            where = self.expr()
+        return SelectStmt(table, columns, where)
+
+    def delete(self) -> Statement:
+        self.expect_kw("DELETE")
+        self.expect_kw("FROM")
+        table = self.expect_ident()
+        where = None
+        if self.is_kw("WHERE"):
+            self.advance()
+            where = self.expr()
+        return DeleteStmt(table, where)
+
+    # -- expressions ------------------------------------------------------
+
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_kw("OR"):
+            self.advance()
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_kw("AND"):
+            self.advance()
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_kw("NOT"):
+            self.advance()
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.is_kw("IS"):
+            self.advance()
+            negated = False
+            if self.is_kw("NOT"):
+                self.advance()
+                negated = True
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if tok.type is TokenType.OPERATOR and tok.value == "(":
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        if tok.type in (TokenType.INTEGER, TokenType.STRING) or (
+            tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL")
+        ):
+            return Literal(self.literal_value())
+        raise self.error("expected expression")
+
+
