@@ -45,6 +45,215 @@ from minidb.types import (
 __all__ = ["parse", "parse_script", "parse_expression"]
 
 
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = list(tokens)
+        if not self.tokens or self.tokens[-1].type is not TokenType.EOF:
+            self.tokens.append(Token(TokenType.EOF, ""))
+        self.pos = 0
+
+    # -- helpers ----------------------------------------------------------
+
+    def peek(self) -> Token:
+        return self.tokens[self.pos]
+
+    def advance(self) -> Token:
+        tok = self.tokens[self.pos]
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def error(self, message: str) -> SQLSyntaxError:
+        tok = self.peek()
+        found = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{message}, found {found}")
+
+    def is_kw(self, word: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value == word
+
+    def is_op(self, sym: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value == sym
+
+    def accept_kw(self, word: str) -> bool:
+        if self.is_kw(word):
+            self.advance()
+            return True
+        return False
+
+    def accept_op(self, sym: str) -> bool:
+        if self.is_op(sym):
+            self.advance()
+            return True
+        return False
+
+    def expect_kw(self, word: str) -> None:
+        if not self.accept_kw(word):
+            raise self.error(f"expected {word}")
+
+    def expect_op(self, sym: str) -> None:
+        if not self.accept_op(sym):
+            raise self.error(f"expected '{sym}'")
+
+    def expect_ident(self) -> str:
+        tok = self.peek()
+        if tok.type is not TokenType.IDENTIFIER:
+            raise self.error("expected identifier")
+        self.advance()
+        return tok.value
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    # -- statements -------------------------------------------------------
+
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "CREATE":
+                return self.create()
+            if tok.value == "DROP":
+                return self.drop()
+            if tok.value == "INSERT":
+                return self.insert()
+            if tok.value == "SELECT":
+                return self.select()
+            if tok.value == "DELETE":
+                return self.delete()
+        raise self.error("expected a statement")
+
+    def create(self) -> Statement:
+        self.expect_kw("CREATE")
+        self.expect_kw("TABLE")
+        name = self.expect_ident()
+        self.expect_op("(")
+        cols = [self.column_def()]
+        while self.accept_op(","):
+            cols.append(self.column_def())
+        self.expect_op(")")
+        return CreateTableStmt(name, tuple(cols))
+
+    def column_def(self) -> ColumnDef:
+        name = self.expect_ident()
+        tok = self.peek()
+        if tok.type is TokenType.KEYWORD and tok.value in (
+            "INTEGER",
+            "TEXT",
+            "BOOLEAN",
+        ):
+            self.advance()
+            return ColumnDef(name, ColumnType(tok.value))
+        raise self.error("expected column type")
+
+    def drop(self) -> Statement:
+        self.expect_kw("DROP")
+        self.expect_kw("TABLE")
+        return DropTableStmt(self.expect_ident())
+
+    def insert(self) -> Statement:
+        self.expect_kw("INSERT")
+        self.expect_kw("INTO")
+        name = self.expect_ident()
+        columns = None
+        if self.accept_op("("):
+            cols = [self.expect_ident()]
+            while self.accept_op(","):
+                cols.append(self.expect_ident())
+            self.expect_op(")")
+            columns = tuple(cols)
+        self.expect_kw("VALUES")
+        self.expect_op("(")
+        vals = [self.literal_value()]
+        while self.accept_op(","):
+            vals.append(self.literal_value())
+        self.expect_op(")")
+        return InsertStmt(name, columns, tuple(vals))
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.advance()
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.advance()
+            return tok.value
+        if tok.type is TokenType.KEYWORD:
+            if tok.value == "TRUE":
+                self.advance()
+                return True
+            if tok.value == "FALSE":
+                self.advance()
+                return False
+            if tok.value == "NULL":
+                self.advance()
+                return None
+        raise self.error("expected literal value")
+
+    def select(self) -> Statement:
+        self.expect_kw("SELECT")
+        columns = None
+        if not self.accept_op("*"):
+            cols = [self.expect_ident()]
+            while self.accept_op(","):
+                cols.append(self.expect_ident())
+            columns = tuple(cols)
+        self.expect_kw("FROM")
+        name = self.expect_ident()
+        where = self.expr() if self.accept_kw("WHERE") else None
+        return SelectStmt(name, columns, where)
+
+    def delete(self) -> Statement:
+        self.expect_kw("DELETE")
+        self.expect_kw("FROM")
+        name = self.expect_ident()
+        where = self.expr() if self.accept_kw("WHERE") else None
+        return DeleteStmt(name, where)
+
+    # -- expressions ------------------------------------------------------
+
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.accept_kw("OR"):
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.accept_kw("AND"):
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.accept_kw("NOT"):
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.advance()
+            return Comparison(tok.value, left, self.primary())
+        if self.accept_kw("IS"):
+            negated = self.accept_kw("NOT")
+            self.expect_kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.advance()
+            return ColumnRef(tok.value)
+        if tok.type is TokenType.OPERATOR and tok.value == "(":
+            self.advance()
+            inner = self.expr()
+            self.expect_op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
 def parse(tokens: list[Token]) -> Statement:
