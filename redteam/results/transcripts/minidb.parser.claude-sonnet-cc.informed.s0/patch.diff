+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> Token:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return Token(TokenType.EOF, "")
+
+    def next(self) -> Token:
+        tok = self.peek()
+        if tok.type is not TokenType.EOF:
+            self.pos += 1
+        return tok
+
+    def is_kw(self, *words: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.KEYWORD and tok.value in words
+
+    def is_op(self, *ops: str) -> bool:
+        tok = self.peek()
+        return tok.type is TokenType.OPERATOR and tok.value in ops
+
+    def at_eof(self) -> bool:
+        return self.peek().type is TokenType.EOF
+
+    def error(self, msg: str) -> SQLSyntaxError:
+        tok = self.peek()
+        shown = "end of input" if tok.type is TokenType.EOF else repr(tok.value)
+        return SQLSyntaxError(f"{msg}, got {shown}")
+
+    def kw(self, word: str) -> None:
+        if not self.is_kw(word):
+            raise self.error(f"expected {word}")
+        self.pos += 1
+
+    def op(self, symbol: str) -> None:
+        if not self.is_op(symbol):
+            raise self.error(f"expected '{symbol}'")
+        self.pos += 1
+
+    def ident(self) -> str:
+        tok = self.peek()
+        if tok.type is not TokenType.IDENTIFIER:
+            raise self.error("expected identifier")
+        self.pos += 1
+        return tok.value
+
+    def ident_list(self) -> tuple[str, ...]:
+        names = [self.ident()]
+        while self.is_op(","):
+            self.pos += 1
+            names.append(self.ident())
+        return tuple(names)
+
+    def literal_value(self) -> Value:
+        tok = self.peek()
+        if tok.type is TokenType.INTEGER:
+            self.pos += 1
+            return int(tok.value)
+        if tok.type is TokenType.STRING:
+            self.pos += 1
+            return tok.value
+        if tok.type is TokenType.KEYWORD and tok.value in ("TRUE", "FALSE", "NULL"):
+            self.pos += 1
+            return {"TRUE": True, "FALSE": False, "NULL": None}[tok.value]
+        raise self.error("expected literal")
+
+    # statements
+    def statement(self) -> Statement:
+        tok = self.peek()
+        if tok.type is not TokenType.KEYWORD:
+            raise self.error("expected statement")
+        if tok.value == "CREATE":
+            return self.create()
+        if tok.value == "DROP":
+            self.pos += 1
+            self.kw("TABLE")
+            return DropTableStmt(self.ident())
+        if tok.value == "INSERT":
+            return self.insert()
+        if tok.value == "SELECT":
+            return self.select()
+        if tok.value == "DELETE":
+            self.pos += 1
+            self.kw("FROM")
+            table = self.ident()
+            return DeleteStmt(table, self.opt_where())
+        raise self.error("expected statement")
+
+    def opt_where(self) -> Expr | None:
+        if self.is_kw("WHERE"):
+            self.pos += 1
+            return self.expr()
+        return None
+
+    def create(self) -> Statement:
+        self.kw("CREATE")
+        self.kw("TABLE")
+        name = self.ident()
+        self.op("(")
+        cols = []
+        while True:
+            col = self.ident()
+            if not self.is_kw("INTEGER", "TEXT", "BOOLEAN"):
+                raise self.error("expected column type")
+            cols.append(ColumnDef(col, ColumnType(self.next().value)))
+            if self.is_op(","):
+                self.pos += 1
+                continue
+            break
+        self.op(")")
+        return CreateTableStmt(name, tuple(cols))
+
+    def insert(self) -> Statement:
+        self.kw("INSERT")
+        self.kw("INTO")
+        table = self.ident()
+        columns = None
+        if self.is_op("("):
+            self.pos += 1
+            columns = self.ident_list()
+            self.op(")")
+        self.kw("VALUES")
+        self.op("(")
+        values = [self.literal_value()]
+        while self.is_op(","):
+            self.pos += 1
+            values.append(self.literal_value())
+        self.op(")")
+        return InsertStmt(table, columns, tuple(values))
+
+    def select(self) -> Statement:
+        self.kw("SELECT")
+        if self.is_op("*"):
+            self.pos += 1
+            columns = None
+        else:
+            columns = self.ident_list()
+        self.kw("FROM")
+        table = self.ident()
+        return SelectStmt(table, columns, self.opt_where())
+
+    # expressions
+    def expr(self) -> Expr:
+        left = self.and_expr()
+        while self.is_kw("OR"):
+            self.pos += 1
+            left = Or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Expr:
+        left = self.not_expr()
+        while self.is_kw("AND"):
+            self.pos += 1
+            left = And(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Expr:
+        if self.is_kw("NOT"):
+            self.pos += 1
+            return Not(self.not_expr())
+        return self.predicate()
+
+    def predicate(self) -> Expr:
+        left = self.primary()
+        tok = self.peek()
+        if tok.type is TokenType.OPERATOR and tok.value in COMPARISON_OPS:
+            self.pos += 1
+            return Comparison(tok.value, left, self.primary())
+        if self.is_kw("IS"):
+            self.pos += 1
+            negated = False
+            if self.is_kw("NOT"):
+                self.pos += 1
+                negated = True
+            self.kw("NULL")
+            return IsNull(left, negated)
+        return left
+
+    def primary(self) -> Expr:
+        tok = self.peek()
+        if tok.type is TokenType.IDENTIFIER:
+            self.pos += 1
+            return ColumnRef(tok.value)
+        if self.is_op("("):
+            self.pos += 1
+            inner = self.expr()
+            self.op(")")
+            return inner
+        return Literal(self.literal_value())
+
+
