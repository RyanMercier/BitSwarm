 def format_result(result: QueryResult) -> str:
     """Render a QueryResult as text (no trailing newline).
 
     If ``result.columns`` is non-empty: a header line, a separator line of
-    dashes, then one line per row. Each column's width is the max length of
-    its header and formatted cells; every cell is left-justified to that
-    width and cells are joined with ``' | '``. A final line reads
-    ``'(N rows)'``, or ``'(1 row)'`` when N == 1.
-
-    Example::
-
-        id | name
-        -- | -----
-        1  | alice
-        (1 row)
-
-    If ``result.columns`` is empty: ``'OK (N rows affected)'`` with
-    N = ``result.row_count``.
+    dashes, then one line per row, then ``'(N rows)'`` (``'(1 row)'`` for 1).
+    If ``result.columns`` is empty: ``'OK (N rows affected)'``.
     """
-    raise NotImplementedError("format_result not implemented")
+    if not result.columns:
+        return f"OK ({result.row_count} rows affected)"
+    cells = [[format_value(v) for v in row] for row in result.rows]
+    widths = [len(c) for c in result.columns]
+    for row in cells:
+        for i, cell in enumerate(row):
+            if i < len(widths):
+                widths[i] = max(widths[i], len(cell))
+
+    def _line(items: list[str]) -> str:
+        return " | ".join(item.ljust(widths[i]) for i, item in enumerate(items))
+
+    lines = [_line(list(result.columns)), _line(["-" * w for w in widths])]
+    lines.extend(_line(row) for row in cells)
+    count = len(result.rows)
+    lines.append("(1 row)" if count == 1 else f"({count} rows)")
+    return "\n".join(lines)
+
+
+def _run_statement(engine: Engine, sql: str, stdout: TextIO, stderr: TextIO) -> None:
+    try:
+        result = engine.execute(sql)
+    except MiniDBError as error:
+        stderr.write(f"ERROR: {error}\n")
+        return
+    stdout.write(format_result(result) + "\n")
 
 
