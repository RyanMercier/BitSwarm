+        raise SQLSyntaxError(f"Unknown statement: {tokens[0].value}")
 
 
 def parse_script(tokens: list[Token]) -> list[Statement]:
@@ -65,7 +67,28 @@ def parse_script(tokens: list[Token]) -> list[Statement]:
     Raises:
         SQLSyntaxError: if any statement is malformed.
     """
-    raise NotImplementedError("parse_script not implemented")
+    if not tokens or tokens[-1].type != TokenType.EOF:
+        raise SQLSyntaxError("Unexpected tokens or missing EOF")
+
+    # Skip the EOF token for parsing
+    tokens = tokens[:-1]
+
+    statements = []
+    while tokens:
