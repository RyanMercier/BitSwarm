+def _consume_token(tokens: list[Token], expected_type: TokenType, expected_value: Optional[str] = None) -> Token:
+    if not tokens:
+        raise SQLSyntaxError("Unexpected EOF")
+    token = tokens.pop(0)
+    if token.type != expected_type or (expected_value is not None and token.value != expected_value):
+        raise SQLSyntaxError(f"Expected {expected_type}{f' {expected_value}' if expected_value else ''}, got {token.type} {token.value}")
+    return token
+
+def _parse_column_def(tokens: list[Token]) -> ColumnDef:
+    name = _consume_token(tokens, TokenType.IDENTIFIER).value
+    _consume_token(tokens, TokenType.KEYWORD)
+    column_type = ColumnType[_consume_token(tokens, TokenType.KEYWORD).value]
+    return ColumnDef(name, column_type)
+
+def _parse_column_ref(tokens: list[Token]) -> ColumnRef:
+    name = _consume_token(tokens, TokenType.IDENTIFIER).value
+    return ColumnRef(name)
+
+def _parse_literal(tokens: list[Token]) -> Literal:
+    token = _consume_token(tokens, TokenType.KEYWORD)
+    if token.value == "TRUE":
+        return Literal(True)
+    elif token.value == "FALSE":
+        return Literal(False)
+    elif token.value == "NULL":
+        return Literal(None)
+    else:
+        raise SQLSyntaxError(f"Unexpected literal: {token.value}")
+
+def _parse_value(tokens: list[Token]) -> Value:
+    token = tokens.pop(0)
+    if token.type == TokenType.KEYWORD and token.value == "TRUE":
+        return True
+    elif token.type == TokenType.KEYWORD and token.value == "FALSE":
+        return False
+    elif token.type == TokenType.KEYWORD and token.value == "NULL":
+        return None
+    elif token.type == TokenType.INTEGER:
+        return int(token.value)
+    elif token.type == TokenType.STRING:
+        return token.value
+    else:
+        raise SQLSyntaxError(f"Unexpected value: {token.value}")
+
+def _parse_comparison(tokens: list[Token]) -> Comparison:
+    left = _parse_primary(tokens)
+    op = _consume_token(tokens, TokenType.OPERATOR, COMPARISON_OPS).value
+    right = _parse_primary(tokens)
+    return Comparison(op, left, right)
+
+def _parse_is_null(tokens: list[Token]) -> IsNull:
+    operand = _parse_primary(tokens)
+    _consume_token(tokens, TokenType.KEYWORD, "IS")
+    negated = False
+    if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "NOT":
+        _consume_token(tokens, TokenType.KEYWORD, "NOT")
+        negated = True
+    _consume_token(tokens, TokenType.KEYWORD, "NULL")
+    return IsNull(operand, negated)
+
+def _parse_primary(tokens: list[Token]) -> Expr:
+    if tokens[0].type == TokenType.KEYWORD and tokens[0].value in ("TRUE", "FALSE", "NULL"):
+        return _parse_literal(tokens)
+    elif tokens[0].type == TokenType.IDENTIFIER:
+        return _parse_column_ref(tokens)
+    elif tokens[0].type == TokenType.INTEGER or tokens[0].type == TokenType.STRING:
+        return Literal(_parse_value([tokens[0]]))
+    elif tokens[0].type == TokenType.OPERATOR and tokens[0].value == "(":
+        _consume_token(tokens, TokenType.OPERATOR, "(")
+        expr = parse_expression(tokens)
+        _consume_token(tokens, TokenType.OPERATOR, ")")
+        return expr
+    else:
+        raise SQLSyntaxError(f"Unexpected token: {tokens[0]}")
+
+def _parse_not_expr(tokens: list[Token]) -> Expr:
+    if tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "NOT":
+        _consume_token(tokens, TokenType.KEYWORD, "NOT")
+        return Not(_parse_not_expr(tokens))
+    return _parse_predicate(tokens)
+
+def _parse_predicate(tokens: list[Token]) -> Expr:
+    if tokens[0].type == TokenType.KEYWORD and tokens[0].value == "IS":
+        return _parse_is_null(tokens)
+    return _parse_comparison(tokens)
+
+def _parse_and_expr(tokens: list[Token]) -> Expr:
+    expr = _parse_not_expr(tokens)
+    while tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "AND":
+        _consume_token(tokens, TokenType.KEYWORD, "AND")
+        expr = And(expr, _parse_not_expr(tokens))
+    return expr
+
+def _parse_or_expr(tokens: list[Token]) -> Expr:
+    expr = _parse_and_expr(tokens)
+    while tokens and tokens[0].type == TokenType.KEYWORD and tokens[0].value == "OR":
+        _consume_token(tokens, TokenType.KEYWORD, "OR")
+        expr = Or(expr, _parse_and_expr(tokens))
+    return expr
 
