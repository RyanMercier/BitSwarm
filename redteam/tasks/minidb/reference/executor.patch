+def execute_select(stmt: SelectStmt, store: StorageBackend,
+                   matches: WhereMatcher) -> QueryResult:
+    schema = store.get_schema(stmt.table)
+    if stmt.columns is None:
+        names = schema.column_names()
+        indices = list(range(len(schema)))
+    else:
+        names = list(stmt.columns)
+        indices = [schema.index_of(n) for n in names]
