        "patch": "--- a/solution.py\n+++ b/solution.py\n@@ -1,2 +1,30 @@\n-def dependency_order(graph):\n-    return sorted(graph)\n+import heapq\n+\n+\n+def dependency_order(graph):\n+    if not graph:\n+        return []\n+    deps = {}\n+    for node, prereqs in graph.items():\n+        node_deps = deps.setdefault(node, set())\n+        for p in prereqs:\n+            node_deps.add(p)\n+            deps.setdefault(p, set())\n+    indegree = {n: len(ps) for n, ps in deps.items()}\n+    dependents = {n: [] for n in deps}\n+    for n, ps in deps.items():\n+        for p in ps:\n+            dependents[p].append(n)\n+    heap = [n for n, d in indegree.items() if d == 0]\n+    heapq.heapify(heap)\n+    order = []\n+    while heap:\n+        n = heapq.heappop(heap)\n+        order.append(n)\n+        for d in dependents[n]:\n+            indegree[d] -= 1\n+            if indegree[d] == 0:\n+                heapq.heappush(heap, d)\n+    if len(order) != len(deps):\n+        raise ValueError(\"cycle detected\")\n+    return order\n"
