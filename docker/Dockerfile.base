# BitSwarm sandbox image, Python only (redteam branch).
#
# validator/sandbox.py runs every gate command and every agent bash
# command inside this image with --network=none, a CPU / memory / pid
# ceiling, the caller's uid, and only the repo under test mounted at
# /work. Nothing else from the host is visible.
#
# The upstream image carried seven language toolchains plus the claude
# CLI (~2.5 GB). The red-team study is Python only, so this keeps the
# interpreter, pytest, and the shell tools an agent reaches for.
#
# Build:
#   docker build -f docker/Dockerfile.base -t bitswarm-base:latest .

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pytest==8.3.5

RUN set -eux \
    && python3 --version \
    && python3 -m pytest --version \
    && git --version
